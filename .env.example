# EasyOKAPI environment configuration. Copy to `.env` and edit as needed.
# `.env` is git-ignored and (in a frozen build) lives in the per-user app-data dir.

# ── Build-time ───────────────────────────────────────────────────────────────
# Read by tools/package.py and CI only — never by the running app.
#   true  → freeze a no-source PyInstaller binary for distribution (default)
#   false → ship plain .py source (legacy/dev flow)
ENCODE_SOURCE=true

# ── Dev-only AI override (optional) ──────────────────────────────────────────
# A GROQ_API_KEY here bypasses license activation for local development.
# GROQ_API_KEY=
# AI_MODEL overrides the model for a source run. Leave it unset in normal use: the app then
# sends no model to the proxy and the server picks a live one, so a build can never pin a
# model id that Groq has since retired.
# AI_MODEL=openai/gpt-oss-20b
