[
  {
    "id": "app_introduction",
    "steps": [
      {
        "target": "#meas-mode-section",
        "description": "Easy OKAPI 有 4 种模式：Kinetics（时间序列）、Point（单时间点）、Calibrate（标准曲线创建）和 Report（数据导出）。我们从 Kinetics 模式开始。"
      },
      {
        "target": "#log-cdc-data",
        "description": "此面板控制 PyBadge 比色计的数据记录。在本教程中，我们将使用示例数据而非实际设备。"
      },
      {
        "target": "#run-script-btn",
        "description": "此按钮开始从比色计实时记录吸光度。现在，只需记住其位置——我们接下来将使用示例文件。"
      },
      {
        "target": "#timeout-control",
        "description": "设置每次记录的持续时间。'Infinite' 将一直记录直到您点击停止。"
      },
      {
        "target": "#interval-control",
        "description": "设置每次读取之间的时间间隔。0 表示尽可能快地获取数据。"
      },
      {
        "target": "#file-selection",
        "description": "选择一个动力学 CSV 文件来探索应用程序。示例文件位于 sample_data 文件夹中——选择任意一个继续。"
      },
      {
        "target": "#chart-container",
        "description": "您的测量数据以时间序列图的形式在此处可视化，显示随时间变化的吸光度。"
      },
      {
        "target": "#select-source-to-export",
        "description": "选择要导出以进行校准的测量源（通道）。"
      },
      {
        "target": "#con-value-read-source-0",
        "description": "输入已知分析物浓度作为参考点，设置文件名，然后点击\"Export Data\"创建校准 CSV。"
      },
      {
        "target": "#data-folder-list",
        "description": "导航到刚刚保存校准 CSV 的目录，以便您可以在下一步中选择它。"
      },
      {
        "target": "#file-selection",
        "description": "找到您导出的校准 CSV。点击\"Edit\"验证其内容，然后选择它。"
      },
      {
        "target": "#measurement-mode",
