data/
node_modules

log/script_logs.txt

# Activation signing keys: the PRIVATE key must never be committed (it lives in
# the server's ACTIVATION_PRIVATE_KEY env var). The public key is embedded in
# src/activation_pubkey.py, so the .pem copies here are just local working files.
/keys/activation_private.pem
/keys/activation_public.pem

# Working artifact: the server-side (online branch) diff, not source.
/online-hardware-lock.patch

# Real git dir is kept here, out of iCloud sync (the .git symlink points to it).
# The ".nosync" suffix tells iCloud (Desktop & Documents) to skip it; this keeps
# the file-sync service from corrupting the repo. See README/setup notes.
/.git.nosync/
