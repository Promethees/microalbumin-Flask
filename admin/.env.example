# Easy OKAPI admin console — local config. Copy to `.env` and fill in.
# The .env file is gitignored; never commit a real key.

# Production server that hosts the shared-secret admin API.
SERVER_URL=https://www.easyokapi.cbbiotec.vn

# Must match the server's ADMIN_API_KEY env var (set on Heroku).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Local port for this console (optional).
ADMIN_UI_PORT=7800
